# Copy to .env (project root) and adjust. Never commit real secrets.

# ---------- Backend ----------
APP_NAME="Hare Ram Portfolio API"
ENVIRONMENT=development
# SQLite (default, development):
# Default when unset: SQLite at backend/portfolio.db
# DATABASE_URL=sqlite:///./portfolio.db
# PostgreSQL (production) — credentials come from your host's secret store:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
SEED_ON_STARTUP=true

# Public profile links (leave blank to hide/disable the buttons)
PORTFOLIO_LINKEDIN_URL=
PORTFOLIO_GITHUB_URL=
PORTFOLIO_EMAIL=
# Optional: path to a real PDF resume. If missing, an HTML resume is generated from the API data.
# RESUME_PATH=app/static/resume.pdf

# ---------- Frontend ----------
PORTFOLIO_API_URL=http://127.0.0.1:8000
PORTFOLIO_API_TIMEOUT=8
PORTFOLIO_CACHE_TTL=120
